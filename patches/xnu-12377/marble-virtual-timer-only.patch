diff --git a/osfmk/arm64/machine_routines.c b/osfmk/arm64/machine_routines.c
index 07143d5..af8f2aa 100644
--- a/osfmk/arm64/machine_routines.c
+++ b/osfmk/arm64/machine_routines.c
@@ -2708,8 +2708,11 @@ _enable_virtual_timer(void)
 	uint64_t cntvctl = CNTV_CTL_EL0_ENABLE; /* One wants to use 32 bits, but "mrs" prefers it this way */
 
 	__builtin_arm_wsr64(KERNEL_CNTV_CTL_EL0, cntvctl);
-	/* disable the physical timer as a precaution, as its registers reset to architecturally unknown values */
-	__builtin_arm_wsr64("CNTP_CTL_EL0", CNTP_CTL_EL0_IMASKED);
+	/*
+	 * marble: Gunyah traps the EL1 CNTP_CTL_EL0 write as UNDEF (device witness: instruction d51be228 in
+	 * fiq_context_init). The virtual timer is enabled above; the physical timer is left to the hypervisor.
+	 * Same finding as MiLacy/UniXNU-marble marble-virtual-timer-only.patch and HakiOS patch 0084.
+	 */
 #if HAS_APPLE_GENERIC_TIMER
 	__builtin_arm_wsr64("S3_1_C15_C13_4", CNTP_CTL_EL0_IMASKED);
 #endif
